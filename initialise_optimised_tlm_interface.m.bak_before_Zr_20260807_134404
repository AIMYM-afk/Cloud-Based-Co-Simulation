function initialise_optimised_tlm_interface()
%% initialise_optimised_tlm_interface.m
% Simulink initialization script.
%
% Final base-workspace variables:
% Z_inf, Rsum, Lsun, C_remain, R_remain,
% R_remain_client, L_remain_client, R_remain_server, L_remain_server,
% Zc_base_R, Zc_base_L,
% R_iron, L_mag,
% line_bZc, line_aZc, line_bHr, line_aHr.
%
% Zc_base_R/Zc_base_L are the extracted high-frequency series impedance:
%   Zc_base(s) = Zc_base_R + s*Zc_base_L
% line_bZc/line_aZc fit only the residual characteristic impedance in ohms:
%   Zc_i = Zc_base_R*i + Zc_base_L*di/dt + ...
%          DiscreteFilter(line_bZc,line_aZc,i)
%
% line_bHr/line_aHr fit Hr after extracting the fixed delay:
%   H(s) = exp(-s*tau) Hr(s)
% The exp(-s*tau) part must be implemented only by the communication delay.

projectDir = fileparts(mfilename('fullpath'));
addpath(fullfile(projectDir,'functions'));

%% Load complete microgrid defaults first
initialize_unitlm_microgrid('skipLineFit');

%% Shared user settings
config = optimised_tlm_interface_config();

params = config.cosimParams;
assignin('base','params',params);

modelName       = config.modelName;
transformerPath = config.transformerPath;

%% Load saved optimised line/interface result
interface = loadOptimisedTlmInterfaceResult(config.filter.saveFile);

sampleTime = interface.line_sampleTime;
fixedDelay = interface.line_fixedDelay;
communicationSteps = round(fixedDelay/sampleTime);

if abs(sampleTime - config.sampleTime) > 1e-15
    error(['Saved interface sample time %.12e does not match ', ...
        'configured sample time %.12e. Regenerate the saved file by ', ...
        'running heaviside_line_equivalent_optimise.m.'], ...
        sampleTime, config.sampleTime);
end

if communicationSteps ~= config.communicationSteps
    error(['Saved interface delay %.12e s gives %d steps, but ', ...
        'configured communication steps is %d. Regenerate the saved file ', ...
        'by running heaviside_line_equivalent_optimise.m.'], ...
        fixedDelay, communicationSteps, config.communicationSteps);
end

%% Read transformer actual branch data
transformer = readTransformerData(modelName,transformerPath);

omegaNominal = 2*pi*transformer.frequency;

%% Actual transformer parameters on each winding base
windingResistance = zeros(size(transformer.windings,1),1);
windingInductance = zeros(size(transformer.windings,1),1);

for k = 1:size(transformer.windings,1)
    windingVoltage = transformer.windings(k,1);
    windingResistancePu = transformer.windings(k,2);
    windingReactancePu = transformer.windings(k,3);

    windingZbase = windingVoltage^2/transformer.nominalPower;

    windingResistance(k) = windingResistancePu*windingZbase;
    windingInductance(k) = ...
        windingReactancePu*windingZbase/omegaNominal;
end

primaryWindingIndex = 1;
primaryVoltage = transformer.windings(primaryWindingIndex,1);
primaryZbase = primaryVoltage^2/transformer.nominalPower;

R_copperloss_1 = windingResistance(primaryWindingIndex);
L_leakageinductance_1 = windingInductance(primaryWindingIndex);
R_copperloss_2 = windingResistance(2);
L_leakageinductance_2 = windingInductance(2);

R_coreloss_1 = transformer.RmPu*primaryZbase;
L_magnetisation_1 = transformer.LmPu*primaryZbase/omegaNominal;

R_iron = R_coreloss_1;
L_mag = L_magnetisation_1;

%% Map saved result to LCTLM model variables
Z_inf    = interface.Z_inf;
Rsum     = interface.Rsum;
Lsun     = interface.Lsun;
Lsum     = interface.Lsum;
C_remain = interface.C_remain;
R_remain = interface.R_remain;
R_remain_client = interface.R_remain_client;
L_remain_client = interface.L_remain_client;
R_remain_server = interface.R_remain_server;
L_remain_server = interface.L_remain_server;
Zc_base_R = interface.Zc_base_R;
Zc_base_L = interface.Zc_base_L;

line_bZc = interface.line_bZc;
line_aZc = interface.line_aZc;
line_bHr = interface.line_bHr;
line_aHr = interface.line_aHr;

%% Export to base workspace
assignin('base','Z_inf',Z_inf);
assignin('base','Rsum',Rsum);
assignin('base','Lsun',Lsun);
assignin('base','Lsum',Lsum);
assignin('base','C_remain',C_remain);
assignin('base','R_remain',R_remain);
assignin('base','R_remain_client',R_remain_client);
assignin('base','L_remain_client',L_remain_client);
assignin('base','R_remain_server',R_remain_server);
assignin('base','L_remain_server',L_remain_server);
assignin('base','Zc_base_R',Zc_base_R);
assignin('base','Zc_base_L',Zc_base_L);
assignin('base','Zc_high_frequency_R',Zc_base_R);
assignin('base','Zc_high_frequency_L',Zc_base_L);
assignin('base','R_iron',R_iron);
assignin('base','L_mag',L_mag);
assignin('base','R_copperloss_1',R_copperloss_1);
assignin('base','L_leakageinductance_1',L_leakageinductance_1);
assignin('base','R_copperloss_2',R_copperloss_2);
assignin('base','L_leakageinductance_2',L_leakageinductance_2);
assignin('base','R_coreloss_1',R_coreloss_1);
assignin('base','L_magnetisation_1',L_magnetisation_1);
assignin('base','line_bZc',line_bZc);
assignin('base','line_aZc',line_aZc);
assignin('base','line_bHr',line_bHr);
assignin('base','line_aHr',line_aHr);
assignin('base','line_sampleTime',sampleTime);
assignin('base','line_delaySteps',communicationSteps);
assignin('base','line_fixedDelay',fixedDelay);

fprintf('\nOptimised TLM interface parameters are ready.\n');
fprintf('Z_inf    = %.12e ohm\n',Z_inf);
fprintf('Rsum     = %.12e ohm\n',Rsum);
fprintf('Lsun     = %.12e H\n',Lsun);
fprintf('C_remain = %.12e F\n',C_remain);
fprintf('R_remain = %.12e ohm\n',R_remain);
fprintf('R_remain_client = %.12e ohm\n',R_remain_client);
fprintf('L_remain_client = %.12e H\n',L_remain_client);
fprintf('R_remain_server = %.12e ohm\n',R_remain_server);
fprintf('L_remain_server = %.12e H\n',L_remain_server);
fprintf('Zc_base_R = %.12e ohm\n',Zc_base_R);
fprintf('Zc_base_L = %.12e H\n',Zc_base_L);
fprintf('R_iron   = %.12e ohm\n',R_iron);
fprintf('L_mag    = %.12e H\n',L_mag);
fprintf('R_copperloss_1 = %.12e ohm\n',R_copperloss_1);
fprintf('L_leakageinductance_1 = %.12e H\n',L_leakageinductance_1);
fprintf('R_copperloss_2 = %.12e ohm\n',R_copperloss_2);
fprintf('L_leakageinductance_2 = %.12e H\n',L_leakageinductance_2);
fprintf('Loaded from:\n%s\n',interface.sourceFile);
end


